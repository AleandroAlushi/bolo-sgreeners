# --- Supabase (Project Settings → API) ---------------------------------------
# URL del progetto
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Chiave pubblica (anon / publishable): sicura nel browser, la RLS protegge i dati
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave service role: SOLO per gli script locali (import storico). Mai nel frontend,
# mai su Vercel, mai nel repository.
SUPABASE_SERVICE_ROLE_KEY=

# --- Sito --------------------------------------------------------------------
# URL pubblico (usato per metadata, OpenGraph e link condivisi)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
