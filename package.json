{
  "name": "bolo-sgreeners",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:html": "tsx scripts/check-html-sources.ts",
    "import:historical": "tsx --env-file-if-exists=.env.local scripts/import-historical/index.ts",
    "db:types": "supabase gen types typescript --linked --schema public > src/lib/supabase/database.types.ts",
    "db:local:reset": "scripts/local-db/reset.sh",
    "db:local:stack": "node scripts/local-db/dev-stack.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "node-html-parser": "^9.0.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "exceljs": "^4.4.0",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
